<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/food_cream_bg"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvAddEditTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Pantry Item"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/food_green_primary"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/etIngredientName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Ingredient Name (e.g., tomato)"
            android:textSize="16sp"
            android:textColor="@color/food_text_main"
            android:textColorHint="@color/food_text_muted"
            android:backgroundTint="@color/food_green_primary"
            android:inputType="text"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etQuantity"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Quantity (e.g., 3.0)"
            android:textSize="16sp"
            android:textColor="@color/food_text_main"
            android:textColorHint="@color/food_text_muted"
            android:backgroundTint="@color/food_green_primary"
            android:inputType="numberDecimal"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etUnit"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Unit (e.g., pieces, grams, cups)"
            android:textSize="16sp"
            android:textColor="@color/food_text_main"
            android:textColorHint="@color/food_text_muted"
            android:backgroundTint="@color/food_green_primary"
            android:inputType="text"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etExpiryDate"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Expiry Date (Optional, e.g., 2026-11-15)"
            android:textSize="16sp"
            android:textColor="@color/food_text_main"
            android:textColorHint="@color/food_text_muted"
            android:backgroundTint="@color/food_green_primary"
            android:inputType="text"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnSavePantry"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Save Item"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/food_green_primary"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>