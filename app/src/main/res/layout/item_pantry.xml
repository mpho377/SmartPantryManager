<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="2dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/food_card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Ingredient Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvIngredientName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tomato"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/food_text_main" />

            <TextView
                android:id="@+id/tvIngredientQty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3.0 pieces"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/food_green_primary"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvIngredientExpiry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expires: 2026-11-15"
                android:textSize="12sp"
                android:textColor="@color/food_text_muted"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Remove Button -->
        <Button
            android:id="@+id/btnRemovePantryItem"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Remove"
            android:textSize="12sp"
            android:backgroundTint="@color/food_terracotta"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="12dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>